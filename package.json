{
  "name": "projeto-pim-cidade",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "tsc --noEmit && vite build --configLoader native",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "api": "node scripts/start-api.mjs",
    "api:seed": "node scripts/start-api.mjs --seed",
    "test:api": "node scripts/test-api.mjs",
    "format": "prettier --write src tests vite.config.ts playwright.config.ts",
    "diagnosticar:sql": "node scripts/start-api.mjs --diagnosticar-sql"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.0.0",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.0",
    "@types/leaflet.heat": "^0.2.5",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^8.3.5"
  }
}
