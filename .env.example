# Segredos e configuração do SERVIDOR ASP.NET Core. Nunca use prefixo VITE_ nestas chaves.
GROQ_API_KEY=your_groq_api_key_here
TOMTOM_API_KEY=your_tomtom_api_key_here
# Aplicação / banco: deixe a conexão vazia para usar ConnectionStrings:SantosConecta do appsettings.
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__SantosConecta=

# Groq / Conecta
Groq__Simular=false
Groq__Model=openai/gpt-oss-20b
Conecta__AIEnabled=true
Conecta__Model=openai/gpt-oss-20b
Conecta__MaxPerUserDay=40
Conecta__MaxPerDay=500

# TomTom
Traffic__Enabled=true
Traffic__IncidentsEnabled=true
Traffic__MaxRequestsPerMonth=2000
Traffic__MaxTileRequestsPerMonth=10000

# SMTP (opcional; mantenha Email__Simular=true até configurar um provedor real)
Email__Simular=true
SMTP_HOST=
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Firebase Cloud Messaging (opcional, arquivo de credencial permanece fora do repositório)
Weather__WorkerEnabled=false
Weather__PushEnabled=false
Weather__FirebaseServiceAccountPath=

# Única configuração pública do Vite; não coloque credenciais em variáveis VITE_*.
VITE_API_URL=
