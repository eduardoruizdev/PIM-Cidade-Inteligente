VITE_API_URL=
# Vazio: utiliza /api e o proxy do Vite para http://localhost:5080.
# URL direta opcional: http://localhost:5080 (use o mesmo hostname no frontend).
# GROQ_API_KEY deve existir SOMENTE no servidor ASP.NET Core.
# TOMTOM_API_KEY deve existir SOMENTE no servidor ASP.NET Core.
# Configure as variáveis abaixo no ambiente do backend (não no .env lido pelo Vite):
# TOMTOM_API_KEY=
# Traffic__Enabled=true
# Traffic__IncidentsEnabled=true
# Traffic__MaxRequestsPerMonth=2000
# Traffic__MaxTileRequestsPerMonth=10000
